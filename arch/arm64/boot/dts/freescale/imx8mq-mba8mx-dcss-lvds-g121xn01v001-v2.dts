#include "imx8mq-mba8mx-dcss-lvds-g121xn01v001.dts"

/delete-node/ &dsi_lvds_bridge;
/delete-node/ &panel0;

&i2c3 {
	dsi_lvds_bridge_v2: dsi-lvds-bridge-v2@2d {
		compatible = "ti,sn65dsi84";
		reg = <0x2d>;
		enable-gpio = <&expander0 6 GPIO_ACTIVE_HIGH>;
		vcc1v8-supply = <&reg_sn65dsi83_1v8>;
		status = "okay";

		/* Auo G121XN01 V001 12.1-inch 1024x768 LVDS Display */
		sn65dsi84,addresses = < 0x09 0x0A 0x0B 0x0D 0x10 0x11 0x12 0x13
					0x18 0x19 0x1A 0x1B 0x20 0x21 0x22 0x23
					0x24 0x25 0x26 0x27 0x28 0x29 0x2A 0x2B
					0x2C 0x2D 0x2E 0x2F 0x30 0x31 0x32 0x33
					0x34 0x35 0x36 0x37 0x38 0x39 0x3A 0x3B
					0x3C 0x3D 0x3E 0xE0 0x0D>;

		sn65dsi84,values =    < 0x00 0x05 0x10 0x00 0x26 0x00 0x2E 0x00
					0x78 0x00 0x03 0x00 0x00 0x04 0x00 0x00
					0x00 0x03 0x00 0x00 0x21 0x00 0x00 0x00
					0x16 0x00 0x00 0x00 0x08 0x00 0x00 0x00
					0xEF 0x00 0x12 0x00 0xEF 0x00 0x12 0x00
					0x00 0x00 0x00 0x01 0x01>;
	};
};

&mipi_dsi {

	panel@0 {
		reg = <0>;
		status = "okay";

		backlight = <&backlight_lvds0>;
		dsi-lanes = <4>;

		/* Auo G121XN01 V001 12.1-inch 1024x768 LVDS Display */
		compatible = "auo,g121xn01v001_mx8m_v2";
		panel-width-mm  = <246>;
		panel-height-mm = <185>;

		delay,prepare = <120>;

		port {
			lvds_bridge_in: endpoint {
				remote-endpoint = <&mipi_dsi_out>;
			};
		};
	};
};
